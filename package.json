{
  "name": "liminal-desktop",
  "version": "1.1.2",
  "description": "다중 LLM 엔진과 MCP 플러그인을 하나의 워크스페이스에서 운용하는 AI 데스크탑 클라이언트",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsup src/main/main.ts src/main/preload.ts --out-dir dist/main --watch --external electron --onSuccess \"electron .\"",
    "dev": "concurrently \"npm run dev:renderer\" \"cross-env NODE_ENV=development npm run dev:main\"",
    "build:renderer": "vite build",
    "build:main": "tsup src/main/main.ts src/main/preload.ts --out-dir dist/main --minify --external electron",
    "build": "npm run build:renderer && npm run build:main",
    "package": "npm run build && electron-builder",
    "build-icon": "electron-icon-builder --input=./src/renderer/assets/icon.png --output=./assets --flatten",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "react",
    "llm",
    "mcp",
    "ai-client"
  ],
  "author": "oxxultus",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@google/genai": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.1",
    "framer-motion": "^12.40.0",
    "node-cron": "^4.2.1",
    "openai": "^6.39.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vls": "^0.8.5"
  },
  "build": {
    "appId": "com.oxxultus.liminal.desktop",
    "productName": "Liminal Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "oxxultus",
        "repo": "liminal-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons"
    }
  }
}
